{
  "name": "mission-control",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo:setup": "bash scripts/demo-setup.sh",
    "api": "pnpm --silent --filter @mission-control/api start",
    "demo:reset": "pnpm --filter @mission-control/api db:seed",
    "demo:login": "node scripts/demo-login.ts",
    "build": "pnpm -r build",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "knip": "^6.39.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3"
  }
}
