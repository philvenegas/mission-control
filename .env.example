# Copied to .env by `pnpm demo:setup`. Local development values only.

# Postgres runs in Docker and is published on this host port.
POSTGRES_PORT=54329
POSTGRES_PASSWORD=postgres

# Superuser: creates the two roles and the databases, nothing else.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
# Owner: owns the tables; runs migrations and the seed.
DATABASE_OWNER_URL=postgres://mc_owner:mc_owner@localhost:54329/mission_control
# API: does not own the tables and cannot bypass row-level security.
DATABASE_URL=postgres://mc_api:mc_api@localhost:54329/mission_control

# A separate database in the same Postgres, used by `pnpm test:int`.
TEST_DATABASE_OWNER_URL=postgres://mc_owner:mc_owner@localhost:54329/mission_control_test
TEST_DATABASE_URL=postgres://mc_api:mc_api@localhost:54329/mission_control_test

# The API.
PORT=3000
TOKEN_SECRET=local-development-secret-change-me
# 12h when unset; a week locally, so the demo profiles outlast a working day.
TOKEN_TTL=7d
